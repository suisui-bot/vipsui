{
  "name": "vipsui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build_seo_catalog.mjs && prisma generate && NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint",
    "test:internal-links": "node scripts/test_internal_links.mjs",
    "test:seo": "node scripts/test_seo_release.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed-admin": "node scripts/seed_admin.mjs",
    "import:wechat-album": "python3 scripts/import_wechat_album_catalog.py",
    "import:wecatalog": "python3 scripts/import_wecatalog_store.py"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
